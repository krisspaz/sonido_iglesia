+//=============================================================================
+#pragma code_seg()
+STDMETHODIMP_(VOID)
+CAdapterCommon::VirtualCableWrite
+(
+    _In_reads_bytes_(ByteCount) const BYTE *Data,
+    _In_ ULONG ByteCount
+)
+{
+    if (Data == NULL || ByteCount == 0)
+    {
+        return;
+    }
+
+    if (ByteCount > VirtualCableCapacityBytes)
+    {
+        Data += ByteCount - VirtualCableCapacityBytes;
+        ByteCount = VirtualCableCapacityBytes;
+    }
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_VirtualCableLock, &oldIrql);
+
+    const ULONGLONG available = m_VirtualCableWritePosition - m_VirtualCableReadPosition;
+    if (available + ByteCount > VirtualCableCapacityBytes)
+    {
+        const ULONGLONG bytesToDrop = available + ByteCount - VirtualCableCapacityBytes;
+        m_VirtualCableReadPosition += bytesToDrop;
+        m_VirtualCableDroppedBytes += bytesToDrop;
+    }
+
+    const ULONG offset = static_cast<ULONG>(m_VirtualCableWritePosition % VirtualCableCapacityBytes);
+    const ULONG firstPart = min(ByteCount, VirtualCableCapacityBytes - offset);
+    RtlCopyMemory(m_VirtualCableBuffer + offset, Data, firstPart);
+
+    if (ByteCount > firstPart)
+    {
+        RtlCopyMemory(m_VirtualCableBuffer, Data + firstPart, ByteCount - firstPart);
+    }
+
+    m_VirtualCableWritePosition += ByteCount;
+    KeReleaseSpinLock(&m_VirtualCableLock, oldIrql);
+}
+
+//=============================================================================
+STDMETHODIMP_(VOID)
+CAdapterCommon::VirtualCableRead
+(
+    _Out_writes_bytes_(ByteCount) BYTE *Data,
+    _In_ ULONG ByteCount
+)
+{
+    if (Data == NULL || ByteCount == 0)
+    {
+        return;
+    }
+
+    RtlZeroMemory(Data, ByteCount);
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_VirtualCableLock, &oldIrql);
+
+    const ULONGLONG available = m_VirtualCableWritePosition - m_VirtualCableReadPosition;
+    const ULONG bytesToRead = static_cast<ULONG>(min(static_cast<ULONGLONG>(ByteCount), available));
+
+    if (bytesToRead > 0)
+    {
+        const ULONG offset = static_cast<ULONG>(m_VirtualCableReadPosition % VirtualCableCapacityBytes);
+        const ULONG firstPart = min(bytesToRead, VirtualCableCapacityBytes - offset);
+        RtlCopyMemory(Data, m_VirtualCableBuffer + offset, firstPart);
+
+        if (bytesToRead > firstPart)
+        {
+            RtlCopyMemory(Data + firstPart, m_VirtualCableBuffer, bytesToRead - firstPart);
+        }
+
+        m_VirtualCableReadPosition += bytesToRead;
+    }
+
+    KeReleaseSpinLock(&m_VirtualCableLock, oldIrql);
+}
+
+#pragma code_seg("PAGE")
+
 //=============================================================================
 #pragma code_seg("PAGE")
 STDMETHODIMP_(void)
diff --git a/audio/sysvad/EndpointsCommon/minwavertstream.h b/audio/sysvad/EndpointsCommon/minwavertstream.h
--- a/audio/sysvad/EndpointsCommon/minwavertstream.h
+++ b/audio/sysvad/EndpointsCommon/minwavertstream.h
@@ -315,6 +315,23 @@ private:
     // Helper functions.
     //
     
+    BOOLEAN IsVirtualCableFormat() const
+    {
+        if (m_pWfExt == NULL
+            || m_pWfExt->Format.nChannels != 2
+            || m_pWfExt->Format.nSamplesPerSec != 48000
+            || m_pWfExt->Format.nBlockAlign != 4
+            || m_pWfExt->Format.wBitsPerSample != 16)
+        {
+            return FALSE;
+        }
+
+        return m_pWfExt->Format.wFormatTag == WAVE_FORMAT_PCM
+            || (m_pWfExt->Format.wFormatTag == WAVE_FORMAT_EXTENSIBLE
+                && m_pWfExt->Format.cbSize >= sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX)
+                && IsEqualGUIDAligned(m_pWfExt->SubFormat, KSDATAFORMAT_SUBTYPE_PCM));
+    }
+
 #pragma code_seg()
     ULONG
     GetAudioModuleListCount()
