{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (VS 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "local-release",
      "displayName": "Local release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/local-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "local-release",
      "configurePreset": "local-release",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "local-release",
      "configurePreset": "local-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
